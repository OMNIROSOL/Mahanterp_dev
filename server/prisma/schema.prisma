model Shipment {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference         String    @unique
  supplierId        String    @map("supplier_id") @db.Uuid
  status            String    @default("Planned") // Planned, In Transit, Arrived, Cleared, Received
  eta               DateTime  @db.Date
  vesselName        String?   @map("vessel_name")
  description       String?
  timestamp         DateTime? @default(now()) @map("timestamp") @db.Timestamptz(6)

  // Additional Details
  countryOfOrigin   String?   @map("country_of_origin")
  portOfArrival     String?   @map("port_of_arrival")
  finalDestination  String?   @map("final_destination")
  internalReference String?   @map("internal_reference")
  blNumber          String?   @map("bl_number")
  invoiceNumber     String?   @map("invoice_number")
  ctrNo             String?   @map("ctr_no")
  freight           String?
  truckNumber       String?   @map("truck_number")
  delayDays         Int?      @map("delay_days") @default(0)
  expectedEta       DateTime? @map("expected_eta") @db.Date

  // Costing Expenses
  fobCharge         Decimal?  @default(0) @map("fob_charge") @db.Decimal(15, 2)
  freightCharge     Decimal?  @default(0) @map("freight_charge") @db.Decimal(15, 2)
  insurance         Decimal?  @default(0) @db.Decimal(15, 2)
  roadTransport     Decimal?  @default(0) @map("road_transport") @db.Decimal(15, 2)
  clearingAgent     Decimal?  @default(0) @map("clearing_agent") @db.Decimal(15, 2)
  duty              Decimal?  @default(0) @db.Decimal(15, 2)
  zabs              Decimal?  @default(0) @db.Decimal(15, 2)
  overweight        Decimal?  @default(0) @db.Decimal(15, 2)
  bankCharges       Decimal?  @default(0) @map("bank_charges") @db.Decimal(15, 2)
  exchangeRate      Decimal?  @default(1) @map("exchange_rate") @db.Decimal(10, 4)

  items    ShipmentItem[]
  supplier suppliers      @relation(fields: [supplierId], references: [id], onDelete: NoAction)

  @@map("shipments")
  @@schema("purchase")
}

model ShipmentItem {
